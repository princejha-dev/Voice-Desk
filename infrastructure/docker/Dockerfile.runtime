FROM python:3.11-slim

WORKDIR /app

# Install system dependencies (audio processing & build tools for LiveKit agent)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libsndfile1 \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY runtime/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy runtime code as package
COPY runtime/ ./runtime

ENV PYTHONPATH=/app

# Run LiveKit agent worker in production start mode
CMD ["python", "runtime/entrypoint.py", "start"]
